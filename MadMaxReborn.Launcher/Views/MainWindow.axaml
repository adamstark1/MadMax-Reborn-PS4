<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MadMaxReborn.Launcher.ViewModels"
        Width="850" Height="650" CanResize="False"
        x:Class="MadMaxReborn.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MadMax Reborn Launcher v1.0.0"
        Background="#121212" Foreground="#E0E0E0"
        FontFamily="Helvetica, Arial, sans-serif">

    <Window.Styles>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#555555" />
            <Setter Property="Foreground" Value="#888888" />
        </Style>
        <Style Selector="SelectableTextBlock">
            <Setter Property="SelectionBrush" Value="#555555" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, *, 200">
        
        <Border BorderBrush="#333333" BorderThickness="0,0,0,1" Grid.Row="0" Padding="20">
            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" Text="{Binding CurrentStepText}"/>
            </StackPanel>
        </Border>
        
        <Grid Grid.Row="1" Background="Transparent">
            <StackPanel HorizontalAlignment="Center" Spacing="20" VerticalAlignment="Center">
                
                <TextBlock FontSize="16" MaxWidth="600" Text="{Binding StepDescription}" TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding !IsStatusVisible}"/>
                
                <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20" IsVisible="{Binding IsStatusVisible}" MinWidth="450">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Save File Data" FontWeight="Bold" FontSize="18" Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scrap Crews Built:" Foreground="#AAAAAA"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CrewsText}" FontWeight="Bold" Foreground="#FFFFFF"/>
                            
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="A Penny Saved:" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PennySavedText}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,5,0,0"/>
                            
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Dividend:" Foreground="#AAAAAA" Margin="0,5,0,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DividendText}" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,5,0,0"/>
                            
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Estimated Time:" Foreground="#AAAAAA" Margin="0,15,0,0" IsVisible="{Binding !IsWaiting}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EstimateText}" FontWeight="Bold" Foreground="#4DA6FF" Margin="0,15,0,0" IsVisible="{Binding !IsWaiting}"/>
                        </Grid>
                        
                        <StackPanel IsVisible="{Binding IsWaiting}" Margin="0,15,0,0">
                            <TextBlock Text="{Binding WaitRemainingText}" FontWeight="Bold" Foreground="#FF8C00" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding WaitProgress}" Height="8" Foreground="#4DA6FF" Background="#333333" CornerRadius="4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                    <Button Background="#FFFFFF" Command="{Binding ExecutePrimaryActionCommand}" Content="{Binding PrimaryButtonText}" CornerRadius="4" FontWeight="Bold" Foreground="#000000" Padding="30,12" IsEnabled="{Binding IsPrimaryEnabled}" IsVisible="{Binding !IsWaiting}"/>
                    
                    <Button Background="Transparent" BorderBrush="#888888" BorderThickness="1" Command="{Binding SkipStepCommand}" Content="{Binding SecondaryButtonText}" CornerRadius="4" FontWeight="Bold" Foreground="#888888" IsVisible="{Binding IsStatusVisible}" Padding="20,12"/>
                </StackPanel>
                
                <StackPanel HorizontalAlignment="Center" Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock FontSize="12" Foreground="#AAAAAA" Text="Stuck on this step? " VerticalAlignment="Center"/>
                    <Button Classes="link" Background="Transparent" BorderThickness="0" Command="{Binding OpenReadmeCommand}" Content="Refer to the README." Cursor="Hand" FontSize="12" Foreground="#4DA6FF" Padding="0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            
            <TextBlock Text="Made by Adam Stark" Foreground="#444444" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="15"/>
        </Grid>
        
        <Border Background="#0A0A0A" BorderBrush="#333333" BorderThickness="0,1,0,0" Grid.Row="2">
            <Grid>
                <ScrollViewer x:Name="TerminalScroll">
                    <SelectableTextBlock FontFamily="Consolas, Monaco, monospace" FontSize="12" Foreground="#AAAAAA" Padding="15" Text="{Binding TerminalOutput}" TextWrapping="Wrap"/>
                </ScrollViewer>
                <Button Command="{Binding CopyLogCommand}" Content="Copy" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Background="#333333" Foreground="#FFFFFF" Padding="15,6" CornerRadius="4" Cursor="Hand" FontSize="12" FontWeight="Bold" ToolTip.Tip="Copy to clipboard"/>
            </Grid>
        </Border>

        <Border Background="#CC000000" IsVisible="{Binding IsGithubPopupVisible}" Grid.RowSpan="3" ZIndex="10">
            <Border Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                <StackPanel Spacing="15" HorizontalAlignment="Center">
                    <TextBlock Text="GitHub Authorization" FontWeight="Bold" FontSize="20" Foreground="#FF8C00" HorizontalAlignment="Center"/>
                    <TextBlock Text="To instantly bypass the wait time, please authorize with GitHub and star the repo. Click the code below to copy it:" TextWrapping="Wrap" TextAlignment="Center" Foreground="#AAAAAA"/>
                    
                    <Button Command="{Binding CopyGithubCodeCommand}" Background="#2A2A2A" CornerRadius="6" Padding="20,10" HorizontalAlignment="Center" Cursor="Hand" ToolTip.Tip="Click to copy code">
                        <TextBlock Text="{Binding GithubUserCode}" FontWeight="Bold" FontSize="28" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    </Button>
                    
                    <Button Content="Open Verification Page" Command="{Binding OpenGithubAuthCommand}" Background="#4DA6FF" Foreground="#000000" FontWeight="Bold" HorizontalAlignment="Center" Padding="20,10" CornerRadius="4"/>
                    
                    <TextBlock Text="{Binding GithubAuthMessage}" Foreground="#888888" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>
                    <Button Content="Skip &amp; Wait" Command="{Binding SkipGithubAuthCommand}" Background="Transparent" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
        
    </Grid>
</Window>